{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "open-mailroom",
	// Set to your Cloudflare account ID, or remove to have wrangler ask.
	// "account_id": "<your-account-id>",
	"compatibility_date": "2025-11-28",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		// Display name in page titles. Icons and the link preview card live in public/brand/.
		"APP_NAME": "Open Mailroom",
		// Production deploys must also define POLICY_AUD and TEAM_DOMAIN.
		// TEAM_DOMAIN must include https://; it may be the base Access URL or full /cdn-cgi/access/certs URL.
		// The worker now fails closed outside local development if Access is not configured.
		"DOMAINS": "example.com",
		"AUTO_DRAFT_ENABLED": "false",
		"EMAIL_ADDRESSES": ["hello@example.com"]
	},
	// Sends scheduled mail and, with ATTACHMENT_SEARCH on, makes attachments searchable.
	"triggers": {
		"crons": ["* * * * *"]
	},
	// Serve the app on your own hostname. Without a route it answers on workers.dev.
	// "routes": [{ "pattern": "mail.example.com", "custom_domain": true }],
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "open-mailroom",
			"preview_bucket_name": "open-mailroom"
		}
	],
	// npm run deploy applies the migrations before it deploys. The Deploy to Cloudflare button
	// creates the database and fills in database_id; by hand, run npx wrangler d1 create open-mailroom.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "open-mailroom",
			"migrations_dir": "migrations"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "EMAIL_AGENT",
				"class_name": "EmailAgent"
			},
			{
				"name": "EMAIL_MCP",
				"class_name": "EmailMCP"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"MailboxDO"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"EmailAgent"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"EmailMCP"
			]
		},
		{
			"tag": "v4",
			"new_sqlite_classes": [
				"MailIndexDO"
			]
		},
		{
			// Deletes the Durable Object mail storage from 0.5 and earlier, and the mail in it.
			"tag": "v5",
			"deleted_classes": [
				"MailboxDO",
				"MailIndexDO"
			]
		}
	]
}
